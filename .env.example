DATABASE_URL="postgresql://user:password@localhost:5432/"
APP_PORT=3000
APP_PREFIX=/api
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/"

GOOGLE_WEB_CLIENT_ID=<your_google_web_client_id>

# Mail envs
MAIL_USER_SERVICE=gmail
MAIL_USER_FROM=<your_email>@gmail.com

# set to "password" or "oauth2" (default: password)
MAIL_AUTH_METHOD=

# if using password auth
MAIL_USER_USER=<your_email>@gmail.com
MAIL_USER_PASS=

ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret